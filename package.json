{
  "name": "nodary",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.12.0",
    "npm": "^11.21.1"
  },
  "packageManager": "npm@11.21.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "http-server out -a 127.0.0.1 -p 4173 -c-1",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build:prototypes": "vite build prototypes",
    "test:prototypes": "playwright test --config=playwright.prototypes.config.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@xyflow/react": "13.0.3",
    "dexie": "4.4.7",
    "lucide-react": "1.82.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.7",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.1.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "fake-indexeddb": "6.2.8",
    "http-server": "14.1.1",
    "jsdom": "27.4.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.1.2"
  }
}
